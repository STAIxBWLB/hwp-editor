{
  "name": "@hwp-editor/core",
  "version": "1.0.0",
  "description": "Framework-free core for hwp-editor: engine interface, typed hwp edit ops, segments, spec types, editor state.",
  "type": "module",
  "license": "MIT",
  "author": "Young Joon Lee <yj.lee@chu.ac.kr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STAIxBWLB/hwp-editor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/STAIxBWLB/hwp-editor#readme",
  "bugs": "https://github.com/STAIxBWLB/hwp-editor/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "schemas"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm gen:types && tsup",
    "gen:types": "node scripts/gen-spec-types.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
