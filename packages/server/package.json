{
  "name": "@hwp-editor/server",
  "version": "1.0.0",
  "description": "Node server adapter for hwp-editor: spawns the hwp-cli binary behind the protocol.ts HTTP contract.",
  "type": "module",
  "license": "MIT",
  "author": "Young Joon Lee <yj.lee@chu.ac.kr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STAIxBWLB/hwp-editor.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/STAIxBWLB/hwp-editor#readme",
  "bugs": "https://github.com/STAIxBWLB/hwp-editor/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./next": {
      "import": { "types": "./dist/next.d.ts", "default": "./dist/next.js" },
      "require": { "types": "./dist/next.d.cts", "default": "./dist/next.cjs" }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hwp-editor/core": "workspace:^"
  },
  "devDependencies": {
    "@hwp-editor/core": "workspace:*",
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
