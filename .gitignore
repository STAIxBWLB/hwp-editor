# Regenerated by `next dev` / `next build`, which point it at different
# `.next/` type paths, so a tracked copy dirtied the tree after every run.
apps/playground/next-env.d.ts

# Written by `next dev` (next/dist/server/lib/generate-agent-files.js): its own Next.js
# agent-rules files; they stay untracked. The root AGENTS.md is the tracked agent
# instruction file (its agent-hub blocks are managed by `ahub init`); .claude/ above stays local.
apps/playground/AGENTS.md
apps/playground/CLAUDE.md
# agent-hub machine-local files (`ahub init` list, plus session checkpoints and backups).
# .agenthub/config.json, routing.toml and sdlc.toml are the tracked, shared files.
.agenthub/state/
.agenthub/config.local.json
.agenthub/routing.local.toml
.agenthub/checkpoint*.md
.agenthub/*.bak-*
.jcode/mcp.json
